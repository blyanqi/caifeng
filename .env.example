# 生产环境配置示例。复制为 .env 后按需修改。
PORT=8787
HOST=127.0.0.1

# 首次初始化管理员（数据库已存在时不会重复创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 32 字节 hex 或 base64；留空则自动生成 data/.app-key
# APP_ENCRYPTION_KEY=

# HTTPS 部署时开启
COOKIE_SECURE=0

SESSION_DAYS=7
SESSION_IDLE_HOURS=24

# 可选：link/XHR 的 JS 动态采集使用 Chrome/Edge
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

